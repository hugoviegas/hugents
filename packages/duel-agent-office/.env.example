# Copy to .env (ignored by Git) and fill in locally. Never commit real values.

# Current Vercel Preview URL (changes per deployment). Production targets are rejected.
# `npm run agent:sync-preview` can update this one value for you.
GAME_BASE_URL=

# QA player credentials (Email/Password login, the default).
QA_ALPHA_EMAIL=
QA_ALPHA_PASSWORD=
QA_BRAVO_EMAIL=
QA_BRAVO_PASSWORD=

# Optional Preview-only Dev Login. When QA_DEV_LOGIN_ENABLED=true it replaces
# Email/Password. The names are the account display names shown by the panel.
QA_DEV_LOGIN_ENABLED=false
QA_DEV_LOGIN_SECRET=
QA_ALPHA_DEV_LOGIN_NAME=
QA_BRAVO_DEV_LOGIN_NAME=

# Run options.
QA_HEADLESS=false
QA_SCREENSHOT_ON_STEP=true
QA_SCENARIO_TIMEOUT_MS=600000

# Heavy local evidence, both OFF by default. Traces (hundreds of MB per player) and videos
# are sensitive: they can contain the Preview URL, session tokens, room codes and typed
# e-mail addresses. Never commit, publish, attach or send them anywhere.
QA_TRACE_ENABLED=false
QA_VIDEO_ENABLED=false

# Local cleanup (`npm run agent:cleanup-artifacts`). Defaults shown.
QA_ARTIFACT_MAX_BYTES=2147483648
QA_ARTIFACT_KEEP_RECENT_RUNS=20
QA_ARTIFACT_KEEP_FAILURE_RUNS=10

# Local QA agent office (issue #98), all optional. See docs/agent-office.md.
# OFFICE_MODEL=llama3.2:latest
# OFFICE_VISION_MODEL=
# OFFICE_OLLAMA_URL=http://127.0.0.1:11434
# OFFICE_BRIDGE_PORT=3100
# OFFICE_READONLY=false

# Report-writing providers for the office (issue #98). Order: gemini -> ollama -> deterministic template.
# Read only by the local bridge. Never a VITE_ variable, never used from duelo/, never printed or logged.
# AI_PROVIDER=gemini                       # gemini | ollama | deterministic (unset: gemini when enabled, else ollama)
# GEMINI_ENABLED=false                     # must be true to use Gemini at all
# GEMINI_API_KEY=                          # your own key from Google AI Studio; keep it only in this ignored .env
# GEMINI_MODEL=gemini-3.5-flash-lite       # no default in code: check which models your project can use
# GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite   # comma list, tried when the primary is out of quota
# GEMINI_TIMEOUT_MS=30000
# GEMINI_MAX_OUTPUT_TOKENS=1024
# GEMINI_MAX_REQUESTS_PER_RUN=3            # per analysed run, all models together, retries count
# GEMINI_MAX_REQUESTS_PER_DAY=20           # per model per day (Pacific midnight reset)
# Screenshots for the design-critic. OFF by default: with it off no image byte is ever sent to Gemini.
# Real pixels are the one thing the runner cannot redact (only e-mail text is masked), so this is an explicit choice.
# GEMINI_SEND_SCREENSHOTS=false            # true: design-critic sends observer-approved screenshots to Gemini
# GEMINI_MAX_SCREENSHOTS=4                 # per review, 1..8
# GEMINI_MAX_SCREENSHOT_BYTES=1500000      # per image; larger ones are skipped
# OFFICE_VISION_MODEL=                     # local Ollama vision model (e.g. llama3.2-vision): the local alternative, no flag needed
# OFFICE_OLLAMA_ENABLED=true               # false removes Ollama from the chain
