+// ── Agent Office design (office/theme/agent-office.css) ─────────────────────────────
+// The map keeps its layout; its colours come from the design tokens, so it follows the theme.
+const cssVar = (name: string, fallback: string) => {
+    if (typeof document === 'undefined') return fallback;
