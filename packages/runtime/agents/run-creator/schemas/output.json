{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "draftId": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "contentHash": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "checks": {
      "type": "integer",
      "minimum": 0,
      "maximum": 400
    }
  },
  "required": [
    "draftId",
    "contentHash"
  ]
}
