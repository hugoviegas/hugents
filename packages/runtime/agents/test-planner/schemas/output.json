{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "screenId": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "goal": {
      "type": "string",
      "maxLength": 200
    }
  },
  "required": [
    "screenId",
    "goal"
  ]
}
